{
  "name": "hono-app-starter-for-yeyu",
  "type": "module",
  "main": "src/index.ts",
  "imports": {
    "#src/*": {
      "development": "./src/*",
      "node": "./dist/*",
      "default": "./src/*"
    }
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "dev": "node --conditions=development --env-file=.env.development --import tsx --watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --max-diagnostics=100 .",
    "lint:fix": "biome check --max-diagnostics=100 --write .",
    "reset:minimal": "node scripts/reset-minimal.mjs",
    "db:generate:dev": "set -a; . ./.env.development; set +a; drizzle-kit generate --config=drizzle.config.ts",
    "db:generate:prod": "set -a; . ./.env.production; set +a; drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate:dev": "set -a; . ./.env.development; set +a; drizzle-kit migrate --config=drizzle.config.ts",
    "db:migrate:prod": "set -a; . ./.env.production; set +a; drizzle-kit migrate --config=drizzle.config.ts",
    "db:push:dev": "set -a; . ./.env.development; set +a; drizzle-kit push --config=drizzle.config.ts",
    "db:studio:dev": "set -a; . ./.env.development; set +a; drizzle-kit studio --config=drizzle.config.ts",
    "db:studio:prod": "set -a; . ./.env.production; set +a; drizzle-kit studio --config=drizzle.config.ts",
    "prepare": "lefthook install",
    "commit": "czg",
    "qwer": "czg",
    "knip": "knip"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@hono/zod-validator": "^0.9.0",
    "bcrypt": "^6.0.0",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@vitest/coverage-v8": "^4.1.10",
    "czg": "^1.13.2",
    "drizzle-kit": "1.0.0-rc.4",
    "knip": "^6.32.2",
    "lefthook": "^2.1.10",
    "lint-staged": "^17.3.0",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
