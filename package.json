{
  "name": "hono-app-starter-for-yeyu",
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "dev": "node --env-file=.env.development --import tsx --watch src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env.production dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --max-diagnostics=100 .",
    "lint:fix": "biome check --max-diagnostics=100 --write .",
    "prepare": "lefthook install",
    "commit": "czg",
    "qwer": "czg"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@hono/zod-validator": "^0.9.0",
    "hono": "^4.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.2.0",
    "czg": "^1.13.2",
    "lefthook": "^2.1.10",
    "lint-staged": "^17.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
